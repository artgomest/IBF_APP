<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IBFAPP">
        <activity
            android:name=".ui.usuarios.MembrosRedeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.perfil.EstatisticasActivity"
            android:exported="false" />
        <activity
            android:name=".ui.configuracoes.EditarRedeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.dashboard.LiderDashboardActivity" />
        <activity android:name=".ui.dashboard.PastorDashboardActivity" />
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.admin.AdminAprovarUsuariosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.admin.AdminCadastroUsuarioActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.admin.AdminGerenciarUsuariosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".ui.dashboard.SecretarioDashboardActivity" />
        <activity android:name=".ui.graficos.LiderGraficosActivity" />
        <activity android:name=".ui.relatorios.LiderStatusRelatoriosActivity" />
        <activity android:name=".ui.configuracoes.ConfiguracoesRedeActivity" />
        <activity
            android:name=".ui.usuarios.CadastroUsuarioActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.usuarios.ListaUsuariosRedeActivity" />
        <activity android:name=".ui.main.HomeActivity" />
        <activity
            android:name=".ui.relatorios.FormularioRedeActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.usuarios.SolicitacaoCadastroActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.usuarios.DetalhesUsuarioActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.usuarios.FichaMembroActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.agenda.AgendaActivity" />
        <activity
            android:name=".ui.agenda.AgendarReuniaoActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.agenda.DetalhesReuniaoActivity" />
        <activity
            android:name=".ui.agenda.RelatorioReuniaoActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.usuarios.CadastroMembroActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.relatorios.PastorRelatoriosActivity" />

        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>