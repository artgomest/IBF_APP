<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- =========================================== -->
    <!--   ALABASTER OBSIDIAN - Inverted (Dark Mode) -->
    <!--   Paleta: Obsidian · Surface Warm           -->
    <!-- =========================================== -->

    <!-- Base Palette Overrides -->
    <color name="accent">@color/surface_warm</color>
    <color name="near_black">@color/surface_warm</color>
    <color name="off_white">@color/obsidian</color>
    <color name="accent_container">@color/gray_800</color>
    
    <!-- =========================================== -->
    <!--   DARK MODE tokens                          -->
    <!-- =========================================== -->
    <color name="ibf_background">@color/obsidian</color>
    <color name="ibf_surface">@color/obsidian_light</color> <!-- Cards appear slightly elevated against pure black -->
    <color name="ibf_surface_variant">@color/gray_800</color>
    <color name="ibf_on_background">@color/surface_warm</color>
    <color name="ibf_on_surface">@color/surface_warm</color>
    <color name="ibf_on_surface_variant">@color/gray_300</color>
    <color name="ibf_outline">@color/gray_500</color>
    <color name="ibf_outline_variant">@color/gray_700</color>
    
    <color name="ibf_divider">#33FFFFFF</color>
    <color name="ibf_scrim">#80000000</color>

    <!-- Status Colors (Inverted Alabaster Obsidian) -->
    <color name="ibf_error">#93000A</color>
    <color name="ibf_on_error">#690005</color>
    <color name="ibf_error_container">#93000A</color>
    
    <color name="ibf_success">#43A047</color>
    <color name="ibf_on_success">#003314</color>
    <color name="ibf_success_container">#1A2E20</color>
    
    <color name="ibf_warning">#BCAAA4</color>
    <color name="ibf_warning_container">#3E3531</color>
    
    <!-- =========================================== -->
    <!--   Semantic aliases                          -->
    <!-- =========================================== -->
    <color name="app_background">@color/ibf_background</color>
    <color name="app_text">@color/ibf_on_background</color>
    <color name="app_icon">@color/ibf_on_background</color>
    <color name="app_card_background">@color/ibf_surface</color>
    <color name="app_button_text">@color/obsidian</color>
    <color name="app_divider">@color/ibf_divider</color>

    <color name="semantic_background">@color/ibf_background</color>
    <color name="semantic_text_primary">@color/ibf_on_background</color>
    <color name="semantic_text_secondary">@color/ibf_on_surface_variant</color>
    <color name="semantic_card_background">@color/ibf_surface</color>
    <color name="semantic_input_background">@color/ibf_surface</color>
    <color name="semantic_icon_tint">@color/ibf_on_background</color>
    <color name="semantic_stroke">@color/ibf_outline</color>
    <color name="semantic_accent">@color/accent</color>
    <color name="semantic_divider">@color/ibf_divider</color>

    <color name="text_on_accent">@color/obsidian</color>
    <color name="text_on_accent_secondary">#B30A0A0A</color>

    <color name="status_green">@color/ibf_success</color>
    <color name="status_red">@color/ibf_error</color>

    <color name="bottom_nav_selected">@color/accent</color>
    <color name="bottom_nav_unselected">@color/ibf_on_surface_variant</color>
</resources>