<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card_modern">

    <TextView
        android:id="@+id/text_titulo_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gerenciar: Nome do Usuário"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Funções Atuais:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:id="@+id/container_funcoes_atuais"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adicionar Nova Função:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinner_nova_rede"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/spinner_background"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinner_novo_papel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/spinner_background"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_adicionar_funcao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adicionar Função"
        android:backgroundTint="#0052cc"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_fechar_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fechar"
        android:backgroundTint="#666666" />

</LinearLayout>
