<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient_light"
    android:fillViewport="true"
    tools:context=".ui.main.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- No Stitch design, a logo com a tipografia preta funciona perfeitamente aqui -->
        <ImageView
            android:layout_width="192dp"
            android:layout_height="96dp"
            android:layout_marginBottom="64dp"
            android:contentDescription="@string/app_logo_content_description"
            android:src="@drawable/care_logo_light"
            android:scaleType="fitCenter"/>

        <!-- Email Input -->
        <EditText
            android:id="@+id/editTextEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_glass_light"
            android:hint="E-mail"
            android:textColorHint="#80131313"
            android:textColor="#131313"
            android:inputType="textEmailAddress"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Password Input -->
        <EditText
            android:id="@+id/editTextPassword"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_glass_light"
            android:hint="Senha"
            android:textColorHint="#80131313"
            android:textColor="#131313"
            android:inputType="textPassword"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="32dp" />

        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/login_button_text"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1F1F1F"
            app:cornerRadius="12dp"
            android:elevation="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esqueci minha senha"
                android:textColor="#52473A"
                android:textStyle="bold"
                android:textSize="15sp"
                android:padding="8dp"/>

            <View
                android:layout_width="48dp"
                android:layout_height="1dp"
                android:background="#1A131313"
                android:layout_marginVertical="16dp"/>

            <TextView
                android:id="@+id/text_cadastre_se"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Criar uma conta"
                android:textColor="#52473A"
                android:textStyle="bold"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
