<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Painel Administrativo"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_profile"
                android:layout_gravity="center"
                app:tint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Olá, Administrador"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O que você deseja gerenciar hoje?"
                android:textSize="16sp"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="32dp"/>

            <!-- Seção de Acesso -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acesso aos Painéis"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_modo_pastor"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Modo Pastor"
                android:textSize="16sp"
                app:icon="@drawable/ic_profile"
                app:iconGravity="textStart"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_selecionar_rede"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Acessar Rede Específica"
                android:textSize="16sp"
                app:icon="@drawable/ic_membros"
                app:iconGravity="textStart"
                app:cornerRadius="12dp"
                android:layout_marginBottom="32dp" />

            <!-- Seção de Usuários -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gerenciamento de Usuários"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_aprovar_usuarios"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Aprovar Usuários do Site"
                android:textSize="16sp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cadastrar_manual"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Cadastrar Usuário Manualmente"
                android:textSize="16sp"
                app:icon="@drawable/ic_add"
                android:backgroundTint="#2E7D32"
                android:padding="16dp"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gerenciar_usuarios"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Gerenciar Todos os Usuários"
                android:textSize="16sp"
                app:icon="@drawable/ic_membros"
                app:iconGravity="textStart"
                app:cornerRadius="12dp"
                android:backgroundTint="#0052cc"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sair do App"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="?attr/colorError" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
