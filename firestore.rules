rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read, write: if request.auth != null;
    }
    match /reunioes/{reuniaoId} {
      allow read, write: if request.auth != null;
    }
    match /redes/{redeId} {
      allow read: if true; // Permitir leitura pública para que novos usuários escolham a rede no cadastro
      allow write: if request.auth != null;
    }
    match /relatorios/{relatorioId} {
      allow read, write: if request.auth != null;
    }
    match /solicitacoesCadastro/{solicitacaoId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }
    match /agenda/{itemId} {
      allow read, write: if request.auth != null;
    }
    match /visualizacoesRelatorio/{visualizacaoId} {
      allow create, read: if request.auth != null;
    }
    match /cobrancasManual/{cobrancaId} {
      allow create, read: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
